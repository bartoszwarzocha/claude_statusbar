# Source files
src/**
.vscode/**
.vscode-test/**

# Build files
node_modules/**
out/**
*.vsix

# Development files
.gitignore
.eslintrc.json
eslint.config.js
tsconfig.json
esbuild.js
idea.txt
.claude/**

