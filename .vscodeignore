ALGORITHM.md

# Tests
**/*.test.ts
**/*.spec.ts

# Git files
.git
.gitattributes

# Misc
npm-debug.log*
.DS_Store
*.log

# Exclude accidental files (but keep resources folder)
**/*.jpg
*.png
!resources/*.png
Schowek_*

# Screenshots of the pre-0.4 interface are no longer referenced by the README and
# only inflate the package. They stay in the repository; the *.jpg rule above keeps
# them out of the .vsix.
